# Banco de dados (PostgreSQL local do sistema)
DATABASE_URL="postgresql://itadmin:CHANGE_ME@127.0.0.1:5432/itadmin?schema=public"

# Segredo usado para assinar/derivar tokens de sessão (gerar com: openssl rand -hex 32)
SESSION_SECRET="CHANGE_ME"

# Chave AES-256-GCM base64 de 32 bytes (gerar com: openssl rand -base64 32)
# usada para criptografar segredos em repouso (senha de bind do AD, segredo TOTP).
ENCRYPTION_KEY="CHANGE_ME"

APP_NAME="IT Admin"
APP_URL="http://localhost:3000"
NODE_ENV="production"
